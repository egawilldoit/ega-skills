{
  "name": "@ega-skills/web",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "EGA Skills read-only operations web console (Vercel Node server plus browser SPA)",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "vite",
    "stage": "node -e 'const fs=require(\"fs\");const {spawnSync}=require(\"child_process\");const p=[\"scripts/web/stage-artifact.mjs\",\"../../scripts/web/stage-artifact.mjs\"].find(fs.existsSync);if(!p)process.exit(1);const r=spawnSync(process.execPath,[p,...process.argv.slice(1)],{stdio:\"inherit\"});process.exit(r.status??0)'",
    "prebuild": "pnpm stage",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false --force",
    "typecheck:server": "tsc -p tsconfig.server.json --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ega-skills/mcp": "workspace:*",
    "@ega-skills/project": "workspace:*",
    "@ega-skills/registry": "workspace:*",
    "@supabase/supabase-js": "2.116.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
