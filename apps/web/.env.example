# Browser-visible configuration. Only these two values are read through
# `import.meta.env` and therefore only these two values are ever bundled into
# the SPA. Both are safe to expose: the Supabase publishable key is designed
# for unauthenticated browser use.
#
# NEVER prefix a server secret with `VITE_`. Anything named `VITE_*` is inlined
# into the client bundle at build time and is readable by every visitor. Server
# secrets must keep an unprefixed name (`EGA_*`) so Vite cannot inline them.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# ---------------------------------------------------------------------------
# Server-side configuration (apps/web/server.mts only)
# ---------------------------------------------------------------------------
# These are read from `process.env` inside the Vercel Node server. They are
# never exposed to the browser. No real default values are recorded here on
# purpose: the console must fail closed when any of them is absent rather than
# silently degrade to a placeholder.
#
# Directory holding verified, immutable HubRelease artifacts (the released
# snapshot plus the SQLite artifact) that the BFF reads from disk.
EGA_WEB_ARTIFACT_DIR=
# Optional retained-release manifest. When set it is the source of truth for
# which release digests this deployment is allowed to serve.
EGA_WEB_RETAINED_MANIFEST=
# The release digest this deployment is expected to serve, as `sha256:<64 hex>`.
#
# This is what makes the deployment `stable` rather than `unpinned`, and it is
# the only input that can produce a `mismatch`. Leave it unset and the console
# serves its verified artifact while reporting that nothing authoritative says
# which release it should be — honest, but it will not label anything current.
#
# Set it to the `hub_release_digest` from `packages/mcp/artifact/release-package.json`.
# `scripts/web/stage-artifact.mjs` prints the value it verified.
EGA_WEB_EXPECTED_RELEASE_DIGEST=
# Supabase project URL used by the BFF for control-plane reads.
EGA_SUPABASE_URL=
# Supabase project publishable key for control plane PostgREST and auth calls.
# Required alongside EGA_SUPABASE_URL for hosted Supabase routing (apikey header).
# If EGA_SUPABASE_PUBLISHABLE_KEY is unset, EGA_SUPABASE_ANON_KEY is checked as fallback.
EGA_SUPABASE_PUBLISHABLE_KEY=
EGA_SUPABASE_ANON_KEY=
# Service-role secret key (NOT used for control-plane reads; the BFF never bypasses
# RLS and executes control-plane queries solely under caller session tokens).
EGA_SUPABASE_SECRET_KEY=
# Artifact access policy. Set to "public" to allow anonymous reads on artifact routes.
EGA_WEB_PUBLIC_POLICY=
# Alternate flag for allowing anonymous access on artifact routes ("true" / "false").
EGA_WEB_ALLOW_ANONYMOUS=
