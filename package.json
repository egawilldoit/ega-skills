{
  "name": "ega-skills",
  "version": "1.0.1",
  "private": true,
  "description": "EGA Skills Hub V1 — local-first deterministic agent-skill registry and resolver",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "24",
    "pnpm": "10.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false --force",
    "test": "node --test",
    "contracts:check-a": "node scripts/contracts/validate-contract-a.mjs",
    "contracts:test-a": "node --test tests/contracts/contract-a.test.mjs",
    "specs:check": "node scripts/specs/check-specs.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
