{
  "name": "@ega-skills/mcp",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ega-mcp": "./bin/ega-mcp.mjs",
    "ega-mcp-hosted": "./bin/ega-mcp-hosted.mjs"
  },
