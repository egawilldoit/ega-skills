# Browser-visible configuration. Only these two values are read through
# `import.meta.env` and therefore only these two values are ever bundled into
# the SPA. Both are safe to expose: the Supabase publishable key is designed
# for unauthenticated browser use.
#
# NEVER prefix a server secret with `VITE_`. Anything named `VITE_*` is inlined
# into the client bundle at build time and is readable by every visitor. Server
# secrets must keep an unprefixed name (`EGA_*`) so Vite cannot inline them.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# ---------------------------------------------------------------------------
# Server-side configuration (apps/web/server.mts only)
# ---------------------------------------------------------------------------
# These are read from `process.env` inside the Vercel Node server. They are
# never exposed to the browser. No real default values are recorded here on
# purpose: the console must fail closed when any of them is absent rather than
# silently degrade to a placeholder.
#
# Directory holding verified, immutable HubRelease artifacts (the released
# snapshot plus the SQLite artifact) that the BFF reads from disk.
EGA_WEB_ARTIFACT_DIR=
# Optional retained-release manifest. When set it is the source of truth for
# which release digests this deployment is allowed to serve.
EGA_WEB_RETAINED_MANIFEST=
# Service-role Supabase credentials used by the BFF for control-plane reads.
# The browser authenticates with a first-party user session; the BFF
# impersonates nothing and holds no delegated OAuth tokens.
EGA_SUPABASE_URL=
EGA_SUPABASE_SECRET_KEY=