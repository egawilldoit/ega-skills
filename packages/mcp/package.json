    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ega-skills/hashing": "workspace:*",
    "@ega-skills/project": "workspace:*",
    "@ega-skills/registry": "workspace:*",
    "@ega-skills/router": "workspace:*",
    "@ega-skills/schema": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "13.0.3"
  }
}
