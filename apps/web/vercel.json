{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @ega-skills/web build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "server.mts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["artifact/**/*", "dist/**/*", "dist/*"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.mts"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.supabase.co; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ]
}